rd.ai.llm.api-key=your-llm-api-key
rd.ai.llm.base-url=https://dashscope.aliyuncs.com/compatible-mode/v1
rd.ai.llm.model=qwen3.5-plus

rd.ai.tts.api-key=your-tts-api-key
rd.ai.tts.ws-url=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
rd.ai.tts.model=qwen3-tts-flash-realtime
rd.ai.tts.voice=Cherry
rd.ai.tts.sample-rate=24000
rd.ai.tts.mode=server_commit
rd.ai.tts.response-format=pcm