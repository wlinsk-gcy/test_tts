# Copy this file to application-local.properties for local secrets.
# This file is safe to commit. application-local.properties is ignored.

rd.ai.llm.api-key=your-llm-api-key
rd.ai.llm.base-url=https://dashscope.aliyuncs.com/compatible-mode/v1
rd.ai.llm.model=qwen3.5-plus

rd.ai.tts.api-key=your-tts-api-key
rd.ai.tts.ws-url=wss://dashscope.aliyuncs.com/api-ws/v1/inference
rd.ai.tts.model=qwen-audio-3.0-tts-flash
rd.ai.tts.zh-voice=longanhuan_v3.6
rd.ai.tts.en-voice=loongmary
rd.ai.tts.sample-rate=24000
rd.ai.tts.response-format=pcm
rd.ai.tts.task-timeout-ms=60000
rd.ai.tts.pool.max-total=16
rd.ai.tts.pool.borrow-timeout-ms=3000
rd.ai.tts.session.max-active-sessions=128
rd.ai.tts.session.idle-timeout-ms=300000

rd.ai.cosyvoice.api-key=your-cosyvoice-api-key
rd.ai.cosyvoice.ws-url=wss://dashscope.aliyuncs.com/api-ws/v1/inference/
rd.ai.cosyvoice.model=cosyvoice-v3-flash
rd.ai.cosyvoice.sample-rate=22050
rd.ai.cosyvoice.format=pcm
rd.ai.cosyvoice.zh-voice=zh_voice
rd.ai.cosyvoice.en-voice=en_voice
rd.ai.cosyvoice.connect-timeout-ms=30000
rd.ai.cosyvoice.task-timeout-ms=60000
rd.ai.cosyvoice.stream-timeout-ms=300000
rd.ai.cosyvoice.pool.max-size=16
rd.ai.cosyvoice.pool.acquire-timeout-ms=3000
rd.ai.cosyvoice.pool.idle-ttl-ms=55000
